      "entries": [
        {
          "id": "f75fc5b1-1a4e-5110-9ef6-1f8d33f7b30e",
          "isHidden": false,
          "text": "<p>Operations executive with 18 years in retail and consumer brands across Vietnam, Thailand and the Philippines. As COO, grew a 420-store chain to profitability in two years while lifting customer satisfaction. Known for building leadership teams, turning around under-performing regions, and running disciplined capital programs. Board member of two industry bodies.</p>"
        }
      ]
    },
    "980f7478-3cf6-5248-a5a2-35149a25dfa6": {
      "sectionType": "custom",
      "displayName": "Selected Achievements",
      "iconKey": "trophy",
      "entries": [
        {
          "id": "0bdefc01-9120-53e3-bb85-5b727f193bb5",
          "isHidden": false,
          "title": "Returned a 420-store chain to profit",
          "description": "<p>Moved EBITDA from −2% to +7% in 24 months through store-portfolio pruning, supply renegotiation and a new operating model.</p>"
        },
        {
          "id": "87b40818-5b60-53fe-87dd-488179637359",
          "isHidden": false,
          "title": "Scaled into two new markets",
          "description": "<p>Opened 85 stores in Thailand and the Philippines in 3 years, each market profitable within 18 months.</p>"
        },
        {
          "id": "ca721de5-59e4-54f5-9b64-978de2edda89",
          "isHidden": false,
          "title": "Built the next leadership bench",
          "description": "<p>Designed a regional-manager academy; 70% of senior operations roles are now filled internally.</p>"
        }
      ]
    },
