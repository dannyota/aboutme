{
  "id": "academic-dense",
  "name": "Academic Dense",
  "description": "Long-form academic CV: one column, 9.75 pt body, year-only dates, and ruled section landmarks that stay findable across many pages.",
  "customization": {
    "font": {
      "family": "source-sans-3",
      "baseSizePx": 13
    },
    "colors": {
      "primary": "#12293f",
      "text": "#1a1e22",
      "background": "#ffffff"
    },
    "spacing": {
      "sectionGap": 20,
      "entryGap": 6,
      "lineHeight": 1.3,
      "pageMargin": {
        "x": 20,
        "y": 12
      }
    },
    "heading": {
      "style": "uppercase",
      "showRule": true
    },
    "header": {
      "align": "left",
      "detailsLayout": "inline",
      "iconStyle": "none"
    },
    "layout": {
      "columns": 1,
      "placement": "keep",
      "surfaceTarget": "none"
    },
    "sectionDisplay": {
      "skill": {
        "style": "text"
      },
      "language": {
        "style": "text"
      }
    },
    "pageFormat": "a4",
    "dateFormat": "YYYY"
  }
}
