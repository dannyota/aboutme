{
  "id": "elegant-serif-two",
  "name": "Elegant Serif Two-Column",
  "description": "Two-column serif document with a warm ecru rail: claret title-case headings, credentials at the top of the rail, one ink throughout.",
  "customization": {
    "font": {
      "family": "Alegreya",
      "baseSizePx": 14
    },
    "colors": {
      "primary": "#6b2737",
      "text": "#2b2622",
      "background": "#ffffff",
      "surface": "#f2ebdf"
    },
    "spacing": {
      "sectionGap": 24,
      "entryGap": 12,
      "lineHeight": 1.55,
      "pageMargin": {
        "x": 18,
        "y": 16
      }
    },
    "heading": {
      "style": "titlecase",
      "showRule": true
    },
    "header": {
      "align": "left",
      "detailsLayout": "inline",
      "iconStyle": "none"
    },
    "layout": {
      "columns": 2,
      "placement": "byType",
      "sidebarSectionTypes": ["certificate", "skill", "language"],
      "surfaceTarget": "sidebar"
    },
    "sectionDisplay": {
      "skill": {
        "style": "text"
      },
      "language": {
        "style": "dots"
      }
    },
    "pageFormat": "a4",
    "dateFormat": "Mon YYYY"
  }
}
