# Copy to .env and fill in. NEVER commit .env.
# Keep values in .env only. This file documents variable names and safe blanks.

# --- dev stack (deploy/compose.yml) ---
# See deploy/compose.yml, deploy/caddy/Caddyfile, and deploy/README.md.
#
# POSTGRES_PASSWORD is REQUIRED — compose.yml has no baked-in default,
# because this compose file is also the local deployment artifact and a
# known default credential must never ship to operators.
# Generate a local one, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=

# MinIO credentials are REQUIRED for the private Compose media service.
# compose.yml has no baked-in defaults for either value. Generate two
# independent values, e.g. with `openssl rand -hex 16` for the access key and
# `openssl rand -hex 32` for the secret key, then put only the results in .env.
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=

# Compose fixes MEDIA_BACKEND=s3, MEDIA_ENDPOINT=http://media:9000, and
# MEDIA_FORCE_PATH_STYLE=true. The optional bucket and region default to
# aboutme-media and us-east-1.
MEDIA_BUCKET=
MEDIA_REGION=

# The server's complete media contract also includes the mode selectors below.
# Compose fixes them internally. Native development sets filesystem mode in
# scripts/dev-native.sh. Leave these blank in the root Compose .env file.
MEDIA_BACKEND=
MEDIA_FS_DIR=
MEDIA_ENDPOINT=
MEDIA_FORCE_PATH_STYLE=

# Everything else below is optional; Compose falls back to working dev
# defaults when unset.
POSTGRES_USER=
POSTGRES_DB=
LOG_LEVEL=
NUXT_PUBLIC_API_BASE=
# Host port for the current Compose Caddy HTTP listener (defaults to 80).
# Rootless Podman may require 8080. This HTTP setting does not satisfy the
# separate local-UAT HTTPS/443 contract; see docs/runbooks/local-uat.md.
CADDY_HTTP_PORT=
# Origin the browser reaches the stack on, as scheme://host[:port] with no
# trailing slash (auth cookies, OAuth redirect URIs, CSRF Origin checks).
# When unset, compose derives it from CADDY_HTTP_PORT
# (http://localhost:<port>), so the two cannot diverge; set it explicitly
# only when the browser-facing origin differs from the published port.
PUBLIC_ORIGIN=

# Remote MCP agent access and its first-party OAuth authorization server.
# Leave false or blank to keep all /.well-known OAuth, /oauth, and /mcp routes
# unregistered. Rate, concurrency, grant, and body bounds are fixed in code
# from docs/design/budgets.md and are not operator-overridable.
MCP_ENABLED=

# Immutable application and public-renderer image/source identities. Release
# deployment injects OCI digests. Local native launchers derive source-manifest
# digests; direct Compose use must supply the corresponding release values.
APP_BUILD_DIGEST=
PUBLIC_RENDERER_BUILD_DIGEST=

# Trust boundary (deploy/compose.yml). Comma-separated CIDRs Go accepts the
# canonical X-Real-IP header from. Defaults cover common podman/docker
# networks; set explicitly if your compose network differs.
TRUSTED_PROXY_CIDRS=

# Google OAuth ("Sign in with Google") client credentials
# (docs/design/security.md). Create an OAuth 2.0 client in
# the Google Cloud Console, with an authorized redirect URI of
# <PUBLIC_ORIGIN>/api/v1/auth/google/callback. Required when ENV=prod or
# ENV=staging; optional in dev (Google login simply won't work until set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth ("Sign in with GitHub") client credentials
# (docs/design/security.md: plain OAuth2, no OIDC; AC-AUTH-003). Create an
# OAuth App in GitHub Developer Settings, with an
# authorization callback URL of <PUBLIC_ORIGIN>/api/v1/auth/github/callback.
# Required when ENV=prod or ENV=staging; optional in dev (GitHub login
# simply won't work until set).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn OAuth ("Sign in with LinkedIn") client credentials
# (docs/design/security.md). Create an app in the LinkedIn
# Developer Portal with the "Sign In with LinkedIn using OpenID Connect"
# product, with an authorized redirect URI of
# <PUBLIC_ORIGIN>/api/v1/auth/linkedin/callback. Required when ENV=prod or
# ENV=staging; optional in dev (LinkedIn login simply won't work until set).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Native HTTPS authentication harness provider endpoints. Leave all five
# blank for ordinary development so the built-in production endpoints remain
# active. Overrides are accepted only when ENV=dev. OIDC issuers and GitHub
# backchannels must use explicit loopback ports and their fixed provider paths.
# The GitHub authorization URL must equal
# <PUBLIC_ORIGIN>/__uat/oauth/github/authorize, and all three GitHub values must
# be set together.
GOOGLE_OIDC_ISSUER_URL=
LINKEDIN_OIDC_ISSUER_URL=
GITHUB_OAUTH_AUTHORIZE_URL=
GITHUB_OAUTH_TOKEN_URL=
GITHUB_API_BASE_URL=

# Password authentication email (docs/design/deployment.md, "Authentication
# email"). Native and HTTPS development use AUTH_EMAIL_MODE=capture; the local
# lifecycle scripts generate the 32-byte secrets as base64url and the capture
# URL/bearer themselves. Production/staging use AUTH_EMAIL_MODE=ses and the SES
# fields below.
PASSWORD_RATE_HMAC_KEY=
AUTH_EMAIL_ACTIVE_KEY_ID=
AUTH_EMAIL_ACTIVE_KEY=
AUTH_EMAIL_PREVIOUS_KEY_ID=
AUTH_EMAIL_PREVIOUS_KEY=
AUTH_EMAIL_MODE=
AUTH_EMAIL_CAPTURE_URL=
AUTH_EMAIL_CAPTURE_BEARER=
SES_FROM_ADDRESS=
SES_CONFIGURATION_SET=
AWS_REGION=

# Semgrep AppSec Platform token for the connected `semgrep ci` scan (Code +
# Supply Chain + Secrets). Get it from the Semgrep dashboard; in CI it is the
# SEMGREP_APP_TOKEN GitHub Actions secret. Not needed for the offline `make semgrep`.
SEMGREP_APP_TOKEN=
