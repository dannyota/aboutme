# Copy to .env and fill in. NEVER commit .env.
# Keep values in .env only. This file documents variable names and safe blanks.

# --- dev stack (deploy/compose.yml) ---
# See deploy/compose.yml, deploy/caddy/Caddyfile, and deploy/README.md.
#
# POSTGRES_PASSWORD is REQUIRED — compose.yml has no baked-in default,
# because this compose file is also the local deployment artifact and a
# known default credential must never ship to operators.
# Generate a local one, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=
# Everything else below is optional; compose falls back to working dev
# defaults when unset.
POSTGRES_USER=
POSTGRES_DB=
LOG_LEVEL=
NUXT_PUBLIC_API_BASE=
# Host port for the current Compose Caddy HTTP listener (defaults to 80).
# Rootless Podman may require 8080. This HTTP setting does not satisfy the
# separate local-UAT HTTPS/443 contract; see docs/runbooks/local-uat.md.
CADDY_HTTP_PORT=
# Origin the browser reaches the stack on, as scheme://host[:port] with no
# trailing slash (auth cookies, OAuth redirect URIs, CSRF Origin checks).
# When unset, compose derives it from CADDY_HTTP_PORT
# (http://localhost:<port>), so the two cannot diverge; set it explicitly
# only when the browser-facing origin differs from the published port.
PUBLIC_ORIGIN=

# Trust boundary (deploy/compose.yml). Comma-separated CIDRs Go accepts the
# canonical X-Real-IP header from. Defaults cover common podman/docker
# networks; set explicitly if your compose network differs.
TRUSTED_PROXY_CIDRS=

# Google OAuth ("Sign in with Google") client credentials
# (docs/design/security.md). Create an OAuth 2.0 client in
# the Google Cloud Console, with an authorized redirect URI of
# <PUBLIC_ORIGIN>/api/v1/auth/google/callback. Required when ENV=prod or
# ENV=staging; optional in dev (Google login simply won't work until set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth ("Sign in with GitHub") client credentials
# (docs/design/security.md: plain OAuth2, no OIDC; AC-AUTH-003). Create an
# OAuth App in GitHub Developer Settings, with an
# authorization callback URL of <PUBLIC_ORIGIN>/api/v1/auth/github/callback.
# Required when ENV=prod or ENV=staging; optional in dev (GitHub login
# simply won't work until set).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn OAuth ("Sign in with LinkedIn") client credentials
# (docs/design/security.md). Create an app in the LinkedIn
# Developer Portal with the "Sign In with LinkedIn using OpenID Connect"
# product, with an authorized redirect URI of
# <PUBLIC_ORIGIN>/api/v1/auth/linkedin/callback. Required when ENV=prod or
# ENV=staging; optional in dev (LinkedIn login simply won't work until set).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Semgrep AppSec Platform token for the connected `semgrep ci` scan (Code +
# Supply Chain + Secrets). Get it from the Semgrep dashboard; in CI it is the
# SEMGREP_APP_TOKEN GitHub Actions secret. Not needed for the offline `make semgrep`.
SEMGREP_APP_TOKEN=
