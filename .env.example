# Copy to .env and fill in. NEVER commit .env.
# (Server/runtime variables will be added as the apps are scaffolded.)

# --- dev stack (deploy/compose.yml) ---
# See deploy/compose.yml, deploy/caddy/Caddyfile, and deploy/README.md.
#
# POSTGRES_PASSWORD is REQUIRED — compose.yml has no baked-in default,
# because this same compose file is also the self-hosting artifact (spec
# §6) and a known default credential must never ship to operators.
# Generate a local one, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=
# Everything else below is optional; compose falls back to working dev
# defaults when unset.
POSTGRES_USER=
POSTGRES_DB=
LOG_LEVEL=
NUXT_PUBLIC_API_BASE=
# Host port Caddy publishes (defaults to 80). Rootless Podman without a
# `sysctl net.ipv4.ip_unprivileged_port_start` adjustment cannot bind 80;
# set this to e.g. 8080 in that case.
CADDY_HTTP_PORT=
# Origin the browser reaches the stack on, as scheme://host[:port] with no
# trailing slash (auth cookies, OAuth redirect URIs, CSRF Origin checks).
# When unset, compose derives it from CADDY_HTTP_PORT
# (http://localhost:<port>), so the two cannot diverge; set it explicitly
# only when the browser-facing origin differs from the published port.
PUBLIC_ORIGIN=

# Trust boundary (deploy/compose.yml). Comma-separated CIDRs Go accepts the
# canonical X-Real-IP header from. Defaults cover common podman/docker
# networks; set explicitly if your compose network differs.
TRUSTED_PROXY_CIDRS=

# Google OAuth ("Sign in with Google") client credentials
# (docs/specs/aboutme-design.md §3 OAuth). Create an OAuth 2.0 client in
# the Google Cloud Console, with an authorized redirect URI of
# <PUBLIC_ORIGIN>/api/v1/auth/google/callback. Required when ENV=prod or
# ENV=staging; optional in dev (Google login simply won't work until set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Semgrep AppSec Platform token for the connected `semgrep ci` scan (Code +
# Supply Chain + Secrets). Get it from the Semgrep dashboard; in CI it is the
# SEMGREP_APP_TOKEN GitHub Actions secret. Not needed for the offline `make semgrep`.
SEMGREP_APP_TOKEN=
