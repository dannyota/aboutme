# Sends host metadata once a day per failed unit; every aboutme unit and
# the packaged services name it in OnFailure= (docs/design/vietnam-production.md,
# "Logs, metrics, and alarms").
[Unit]
Description=aboutme alert for %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/aboutme/alert.sh unit-%i "unit %i failed"
StandardInput=null
TimeoutStartSec=100s
TimeoutStopSec=5s
StandardOutput=null
StandardError=journal
