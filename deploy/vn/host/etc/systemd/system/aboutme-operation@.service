[Unit]
Description=aboutme host operation %i
After=postgresql@18-main.service
Requires=postgresql@18-main.service
RequiresMountsFor=/srv/data
OnFailure=aboutme-alert@%p-%i.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/lib/aboutme/operation-run.sh run %i
Restart=no
KillMode=control-group
TimeoutStartSec=45min
TimeoutStopSec=60s
LimitCORE=0
StandardOutput=null
StandardError=null
