# Fails, after printing aboutme-backup-stale, when the newest backup is older
# than 26 hours or missing (docs/design/vietnam-production.md, "PostgreSQL").
[Unit]
Description=aboutme newest backup age check
After=postgresql@18-main.service

[Service]
Type=oneshot
User=postgres
ExecStart=/usr/local/lib/aboutme/backup-age.sh
