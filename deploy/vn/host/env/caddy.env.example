# Copied once to /etc/aboutme/caddy.env. The direct edge trusts no forwarding
# header (docs/design/vietnam-production.md, "Edge"). Every name below except
# EDGES and MAINTENANCE is a placeholder until the Caddy image's direct
# listener lands; the CrowdSec bouncer key is a Podman secret.
EDGES=direct
SITE_ADDRESSES=aboutme.vn www.aboutme.vn
CROWDSEC_API_URL=http://127.0.0.1:8095
WAF_MODE=detect
