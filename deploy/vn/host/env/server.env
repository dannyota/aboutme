# Non-secret server settings shared by every host, installed to
# /etc/aboutme/server.env. Host-specific values live in flags.env and
# smtp.env; secrets are Podman secrets (docs/design/vietnam-production.md,
# "Secrets and host identity").
ENV=prod
PORT=8080
LISTEN_HOST=127.0.0.1
TRUSTED_PROXY_CIDRS=127.0.0.1/32
PUBLIC_RENDER_ORIGIN=http://127.0.0.1:3000
PRINT_LISTEN_ADDR=172.17.0.1:8081
MCP_ENABLED=true
OAUTH_REGISTER_EGRESS_CIDRS=160.79.104.0/21
DATABASE_URL=postgres://aboutme_app@/aboutme?host=/run/postgresql
MEDIA_BACKEND=s3
MEDIA_BUCKET=aboutme-media
MEDIA_REGION=HCM04
MEDIA_ENDPOINT=https://hcm04.vstorage.vngcloud.vn
MEDIA_FORCE_PATH_STYLE=true
AUTH_EMAIL_MODE=smtp
