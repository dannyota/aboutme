# Copied once to /etc/aboutme/smtp.env; install.sh never overwrites it. The
# SMTP user and password are Podman secrets, not here
# (docs/design/vietnam-production.md, "DNS and mail"). Bizfly lets an SMTP
# account send only as its own address, so the From address is the sender
# account's.
SMTP_HOST=smtp.bizflycloud.vn
SMTP_PORT=465
SMTP_TLS=implicit
SES_FROM_ADDRESS=danny@aboutme.vn
SES_FROM_NAME=Danny from aboutme.vn
# The support mailbox host/bin/alert.sh mails (design "Logs, metrics, and
# alarms"); the server ignores it.
ALERT_TO=support@aboutme.vn
