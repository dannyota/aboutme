# Copied once to /etc/aboutme/smtp.env and filled in on the host. The SMTP
# user and password are Podman secrets, not here
# (docs/design/vietnam-production.md, "DNS and mail"). The variable names are
# placeholders until the server's SMTP sender lands.
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=implicit
SMTP_FROM_ADDRESS=no-reply@aboutme.vn
SMTP_FROM_NAME=aboutme
# The support mailbox host/bin/alert.sh mails (design "Logs, metrics, and
# alarms"); the server ignores it.
ALERT_TO=support@aboutme.vn
