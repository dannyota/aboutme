# Copied once to /etc/aboutme/flags.env; the owner edits it on the host and
# install.sh never overwrites it. deploy.sh refuses a flag above the release
# fence (docs/design/passkey-release-fence.md). The rehearsal host sets its
# own PUBLIC_ORIGIN (docs/design/vietnam-production.md, "Rehearsal").
PUBLIC_ORIGIN=https://aboutme.vn
PROVIDER_LOGIN_ENABLED=false
PASSWORD_REGISTRATION_ENABLED=false
PASSKEY_ENROLLMENT_ENABLED=false
TOTP_ENROLLMENT_ENABLED=false
SIGN_IN_TO_VIEW_ENABLED=false
PREVIEW_CARD_ENABLED=false
# Which Podman secret the server gets as TOTP_ACTIVE_KEY and
# TOTP_PREVIOUS_KEY: a, b, or empty for no previous key
# (docs/design/totp-key-management.md, "Key ring").
TOTP_ACTIVE_KEY_SLOT=a
TOTP_PREVIOUS_KEY_SLOT=
