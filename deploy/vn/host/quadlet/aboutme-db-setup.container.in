# Rendered by deploy-host.sh; do not edit on the host. First-deploy db-setup
# as the database owner role aboutme, with no network
# (docs/design/single-host-production.md, "Database").
[Unit]
Description=aboutme db-setup
Requires=postgresql@18-main.service
After=postgresql@18-main.service

[Container]
Image=@SERVER_IMAGE@
ContainerName=aboutme-db-setup
Network=none
Environment=DATABASE_URL=postgres://aboutme@/aboutme?host=/run/postgresql
Environment=DEPLOY_RELEASE_TAG=@RELEASE_TAG@
Environment=DEPLOY_RELEASE_NUMBER=@RELEASE_NUMBER@
Secret=db-admin-password,type=env,target=PGPASSWORD
Secret=db-migrator-password,type=env,target=MIGRATOR_PASSWORD
Secret=db-app-password,type=env,target=APP_PASSWORD
Volume=/run/postgresql:/run/postgresql
PodmanArgs=--entrypoint=/usr/local/bin/db-setup --memory=256m
LogDriver=journald

[Service]
Type=oneshot
ExecStartPre=/usr/local/lib/aboutme/fence.sh check @RELEASE_NUMBER@ aboutme-db-setup
TimeoutStartSec=30min
