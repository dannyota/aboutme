# Rendered by deploy-host.sh; do not edit on the host.
[Unit]
OnFailure=aboutme-alert@%N.service
Description=aboutme deployment observer
Requires=aboutme-observer-network.service aboutme-observer-firewall.service
After=aboutme-observer-network.service aboutme-observer-firewall.service

[Container]
Image=@OBSERVER_IMAGE@
ContainerName=aboutme-observer
Exec=run --interval 60s
User=65532:65532
Network=aboutme-observer
DNS=8.8.8.8
DNS=1.1.1.1
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
Environment=OBSERVER_PLATFORM=podman
Environment=OBSERVER_REGION=HCM03
Environment=OBSERVER_TUF_CACHE=/tmp/sigstore-tuf
# Podman 4.9 has no tmpfs uid= option; U chowns the mount to the container user (podman-run(1)).
Tmpfs=/tmp/sigstore-tuf:rw,nosuid,nodev,noexec,size=16m,mode=0700,U
Volume=/var/lib/aboutme/observation:/observation:ro
Volume=/var/lib/aboutme/deployment:/public:rw
PodmanArgs=--memory=128m --sysctl=net.ipv6.conf.all.disable_ipv6=1 --sysctl=net.ipv6.conf.default.disable_ipv6=1
LogDriver=journald

[Service]
LimitCORE=0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
