# Rendered by deploy-host.sh; do not edit on the host. The maintenance Caddy,
# started only by a deploy or a recovery, never at boot
# (docs/design/single-host-production.md, "Release and deploy").
[Unit]
OnFailure=aboutme-alert@%N.service
Description=aboutme maintenance Caddy
Requires=aboutme-crowdsec-retention-startup.service
After=aboutme-crowdsec-retention-startup.service

[Container]
Image=@MAINTENANCE_IMAGE@
ContainerName=aboutme-maintenance
Network=host
EnvironmentFile=/etc/aboutme/caddy.env
Environment=MAINTENANCE=1
Environment=DEPLOY_RELEASE_TAG=@MAINTENANCE_TAG@
Environment=DEPLOY_RELEASE_NUMBER=@MAINTENANCE_NUMBER@
Secret=crowdsec-bouncer-key,type=env,target=CROWDSEC_API_KEY
Volume=/var/lib/aboutme-caddy:/data
Volume=/run/aboutme/caddy-log:/var/log/caddy
PodmanArgs=--memory=128m
LogDriver=journald

[Service]
ExecStartPre=/usr/local/lib/aboutme/crowdsec-retention-lease-check.sh
LimitCORE=0
Restart=no
