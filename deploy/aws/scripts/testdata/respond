#!/usr/bin/env bash
# Canned responses for deploy_test.sh. $STUB_CASE selects the scenario.
cmd=$1
shift
args="$*"
case "$cmd $args" in
  "git fetch"*) exit 0 ;;
  "git rev-list"*) echo 0123456789abcdef0123456789abcdef01234567 ;;
  "git merge-base"*) exit 0 ;;
  "gh run list"*) echo success ;;
  "curl "*"ghcr.io/token"*) echo '{"token":"stub"}' ;;
  "curl "*"/manifests/"*) printf 'docker-content-digest: sha256:%064d\r\n' 1 ;;
  "curl "*"api.cloudflare.com/client/v4/ips"*) echo '{"success":true,"result":{"ipv4_cidrs":["198.51.100.0/24","192.0.2.0/24"]}}' ;;
  "curl -fsSI https://aboutme.vn/")
    # smoke_flaky: the first HSTS probe hits a TLS reset, as right after a
    # Caddy restart.
    if [[ $STUB_CASE == smoke_flaky ]] && ! [[ -e $STUB_DIR/hsts.once ]]; then
      : >"$STUB_DIR/hsts.once"
      exit 35
    fi
    printf 'HTTP/2 200\r\nstrict-transport-security: max-age=31536000\r\n' ;;
  "curl "*"https://aboutme.vn/healthz"*)
    if [[ $STUB_CASE == smoke_down ]]; then echo 502; exit 0; fi
    # smoke_flaky: Cloudflare serves one 525 first.
    if [[ $STUB_CASE == smoke_flaky ]] && ! [[ -e $STUB_DIR/healthz.once ]]; then
      : >"$STUB_DIR/healthz.once"
      echo 525
      exit 0
    fi
    echo 200 ;;
  "curl -s -m 10 -w "*)
    if [[ $STUB_CASE == maintenance_smoke_fails || $STUB_CASE == maintenance_down_fails ]]; then
      printf 'unavailable\n502\n'
    else
      printf '<!-- aboutme:maintenance -->\n503\n'
    fi ;;
  "curl "*"https://aboutme.vn/"*) echo 200 ;;
  "curl "*"https://192.0.2.10/"*)
    # origin_open: the origin answers a direct request.
    if [[ $STUB_CASE == origin_open ]]; then exit 0; fi
    exit 28 ;;
  "curl "*) exit 28 ;;
  "aws "*"ecs describe-task-definition"*)
    # One secret in each valueFrom form: SSM ARN, SSM name, Secrets Manager ARN.
    echo '{"family":"f","networkMode":"bridge","containerDefinitions":[{"name":"caddy","image":"x","environment":[{"name":"CLOUDFLARE_RANGES","value":"192.0.2.0/24 198.51.100.0/24"}]},{"name":"server","image":"x","secrets":[{"name":"PGPASSWORD","valueFrom":"arn:aws:ssm:ap-southeast-1:1:parameter/aboutme/prod/db/app-password"},{"name":"GOOGLE_CLIENT_ID","valueFrom":"/aboutme/prod/oauth/google-client-id"},{"name":"MASTER","valueFrom":"arn:aws:secretsmanager:ap-southeast-1:1:secret:rds!db-abc-XyZ12:password::"}]}]}' ;;
  "aws "*"ssm describe-parameters"*)
    if [[ $STUB_CASE == secret_missing && $args == *google-client-id* ]]; then echo 0; else echo 1; fi ;;
  "aws "*"secretsmanager describe-secret"*)
    if [[ $STUB_CASE == secretsmanager_missing ]]; then
      echo "ResourceNotFoundException" >&2
      exit 254
    fi
    echo 'arn:aws:secretsmanager:ap-southeast-1:1:secret:rds!db-abc-XyZ12' ;;
  "aws "*"ecs describe-services"*"services[0].status"*)
    if [[ $STUB_CASE == maintenance_missing ]]; then echo None; else echo ACTIVE; fi ;;
  "aws "*"ecs describe-services"*) echo 'arn:aws:ecs:ap-southeast-1:1:task-definition/aboutme-prod-app:3' ;;
  "aws "*"ecs list-tasks"*)
    if [[ $STUB_CASE == list_running_fails && $args == *"--service-name aboutme-prod-app"* && $args != *"--desired-status STOPPED"* ]]; then
      exit 255
    fi
    if [[ $STUB_CASE == list_stopped_fails && $args == *"--service-name aboutme-prod-app"* && $args == *"--desired-status STOPPED"* ]]; then
      exit 255
    fi
    if [[ $STUB_CASE == stopping_task ]]; then
      if [[ $args == *"--desired-status STOPPED"* ]]; then
        echo "arn:aws:ecs:ap-southeast-1:1:task/aboutme-prod/stopping-task"
      else
        echo "arn:aws:ecs:ap-southeast-1:1:task/aboutme-prod/running-task"
      fi
    else
      echo "arn:aws:ecs:ap-southeast-1:1:task/aboutme-prod/stub-task"
    fi ;;
  "aws "*"ecs register-task-definition"*)
    file=$(sed -E 's#.*file://([^ ]+).*#\1#' <<<"$args")
    jq -e '.containerDefinitions and (has("revision") | not)' "$file" >/dev/null || exit 3
    echo 'arn:aws:ecs:ap-southeast-1:1:task-definition/new:4' ;;
  "aws "*"ecs run-task"*)
    by=$(sed -E 's/.*--started-by ([^ ]+).*/\1/' <<<"$args")
    if [[ $STUB_CASE == runtask_fails && $by == deploy-migrate ]]; then
      echo "placement failed" >&2
      exit 255
    fi
    echo "arn:aws:ecs:ap-southeast-1:1:task/aboutme-prod/$by" ;;
  "aws "*"ecs update-service"*"aboutme-prod-app"*"desired-count 1"*)
    [[ $STUB_CASE != app_start_update_fails ]] || exit 255 ;;
  "aws "*"ecs wait services-stable"*"aboutme-prod-web"*)
    if [[ $STUB_CASE == start_fails ]]; then exit 255; fi ;;
  "aws "*"ecs wait services-stable"*"aboutme-prod-maintenance"*)
    if [[ $STUB_CASE == maint_up_fails ]]; then exit 255; fi
    if [[ $STUB_CASE == maintenance_down_fails ]]; then
      n=$(($(cat "$STUB_DIR/$STUB_CASE.maint-wait-count" 2>/dev/null || echo 0) + 1))
      echo "$n" >"$STUB_DIR/$STUB_CASE.maint-wait-count"
      ((n != 2)) || exit 255
    fi ;;
  "aws "*"ecs wait services-stable"*"aboutme-prod-app"*)
    if [[ $STUB_CASE == first_app_down_fails ]] && ! [[ -e $STUB_DIR/first-app-wait.once ]]; then
      : >"$STUB_DIR/first-app-wait.once"
      exit 255
    fi
    # app_wait_fails: the first app wait (scaling to 0 at "site down") must
    # succeed; only the second (starting the new app, post-migration) fails.
    if [[ $STUB_CASE == app_wait_fails ]]; then
      if [[ -e $STUB_DIR/app-wait.once ]]; then exit 255; fi
      : >"$STUB_DIR/app-wait.once"
    fi ;;
  "aws "*"ecs wait tasks-stopped"*)
    if [[ $STUB_CASE == wait_timeout && $args == *deploy-migrate* ]]; then exit 255; fi ;;
  "aws "*"ecs describe-tasks"*"lastStatus"*)
    if [[ $STUB_CASE == wait_timeout ]]; then echo RUNNING; else echo STOPPED; fi ;;
  "aws "*"ecs describe-tasks"*)
    if [[ $STUB_CASE == *migrate_fails && $args == *deploy-migrate* ]]; then echo 1;
    elif [[ $STUB_CASE == *db_setup_fails && $args == *deploy-db-setup* ]]; then echo 1;
    else echo 0; fi ;;
  "aws "*"scheduler list-schedules"*) printf 'a\tb\tc\td\n' ;;
  "aws "*"scheduler get-schedule"*)
    state=ENABLED
    [[ $STUB_CASE == first* ]] && state=DISABLED
    if [[ $args == *"--query State"* ]]; then
      echo "$state"
      exit 0
    fi
    printf '{"Name":"a","GroupName":"g","ScheduleExpression":"rate(1 hour)","FlexibleTimeWindow":{"Mode":"OFF"},"Target":{"Arn":"x","RoleArn":"y"},"State":"%s","Arn":"z"}\n' "$state" ;;
  "aws "*"scheduler update-schedule"*)
    file=$(sed -E 's#.*file://([^ ]+).*#\1#' <<<"$args")
    cp "$file" "$STUB_DIR/last-schedule.json"
    # schedule_enable_fails: the enable loop's second schedule (of a, b, c, d)
    # fails after the app is already confirmed healthy; the first stays
    # enabled, the rest are never attempted.
    if [[ $STUB_CASE == schedule_enable_fails ]] && grep -q '"State": "ENABLED"' "$file"; then
      n=$(($(cat "$STUB_DIR/enable-count" 2>/dev/null || echo 0) + 1))
      echo "$n" >"$STUB_DIR/enable-count"
      if ((n == 2)); then
        echo "scheduler throttled" >&2
        exit 254
      fi
    fi ;;
  "aws "*"ec2 describe-addresses"*)
    if [[ $STUB_CASE == origin_unknown ]]; then echo None; exit 0; fi
    echo 192.0.2.10 ;;
  # The snapshot name's time is fixed at 2026-10-20T00:00Z.
  "date -u +%Y%m%d%H%M") echo 202610200000 ;;
  *) exit 0 ;;
esac
