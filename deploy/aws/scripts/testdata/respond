#!/usr/bin/env bash
# Canned responses for deploy_test.sh. $STUB_CASE selects the scenario.
cmd=$1
shift
args="$*"
case "$cmd $args" in
  "git fetch"*) exit 0 ;;
  "git rev-list"*) echo 0123456789abcdef0123456789abcdef01234567 ;;
  "git merge-base"*) exit 0 ;;
  "gh run list"*)
    # The commit stub always returns this SHA (git rev-list, above).
    sha=0123456789abcdef0123456789abcdef01234567
    case $STUB_CASE in
      fence_ci_fails)
        printf '[{"conclusion":"failure","status":"completed","event":"push","headBranch":"main","headSha":"%s"}]\n' "$sha" ;;
      ci_dispatch_only)
        # A green run exists for this commit, but only from a manual dispatch
        # on a branch, never a push run on main.
        printf '[{"conclusion":"success","status":"completed","event":"workflow_dispatch","headBranch":"fix/x","headSha":"%s"}]\n' "$sha" ;;
      ci_dispatch_newer)
        # gh lists newest first: a newer green dispatch run must not hide an
        # older failed push run on main for the same commit.
        printf '[{"conclusion":"success","status":"completed","event":"workflow_dispatch","headBranch":"fix/x","headSha":"%s"},' "$sha"
        printf '{"conclusion":"failure","status":"completed","event":"push","headBranch":"main","headSha":"%s"}]\n' "$sha" ;;
      ci_push_other_branch)
        printf '[{"conclusion":"success","status":"completed","event":"push","headBranch":"release/x","headSha":"%s"}]\n' "$sha" ;;
      ci_wrong_sha)
        printf '[{"conclusion":"success","status":"completed","event":"push","headBranch":"main","headSha":"deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"}]\n' ;;
      ci_push_in_progress)
        # gh's real shape for a run still in progress: conclusion is "", not
        # null.
        printf '[{"conclusion":"","status":"in_progress","event":"push","headBranch":"main","headSha":"%s"}]\n' "$sha" ;;
      *)
        printf '[{"conclusion":"success","status":"completed","event":"push","headBranch":"main","headSha":"%s"}]\n' "$sha" ;;
    esac ;;
  "aws "*"sts get-caller-identity --query Arn --output text")
    case "${AWS_PROFILE:-}" in
      fence-operator)
        if [[ $STUB_CASE == verify_role_fails ]]; then echo 'arn:aws:iam::1:user/not-a-role'
        else echo 'arn:aws:sts::1:assumed-role/aboutme-prod-operator/aboutme-deploy-session'; fi ;;
      fence-deploy) echo 'arn:aws:sts::1:assumed-role/aboutme-prod-deploy/aboutme-deploy-session' ;;
      *) echo 'arn:aws:iam::1:user/aboutme-operator' ;;
    esac ;;
  "aws "*"sts get-caller-identity --query Account --output text") echo 1 ;;
  "aws "*"dynamodb get-item"*)
    # The count distinguishes fence_read's own strong read (a run's first
    # get-item) from fence_lock's later uncertain-acquisition read, for the
    # cases that need a different answer each time.
    n=$(($(cat "$STUB_DIR/get-item-count.$STUB_CASE" 2>/dev/null || echo 0) + 1))
    echo "$n" >"$STUB_DIR/get-item-count.$STUB_CASE"
    case $STUB_CASE in
      fence_lower) echo '{"Item":{"minimum_release":{"N":"5000"},"minimum_tag":{"S":"v0.5.0"}}}' ;;
      fence_equal | fence_activate) echo '{"Item":{"minimum_release":{"N":"1000"},"minimum_tag":{"S":"v0.1.0"}}}' ;;
      fence_activate_4002_then_4007) echo '{"Item":{"minimum_release":{"N":"4002"},"minimum_tag":{"S":"v0.4.2"}}}' ;;
      totp_reencrypt_ok | totp_reencrypt_runtask_fails | totp_reencrypt_task_fails | totp_reencrypt_tag_mismatch | \
      totp_reencrypt_register_fails | totp_reencrypt_slot_mismatch | totp_reencrypt_wait_timeout)
        echo '{"Item":{"minimum_release":{"N":"4007"},"minimum_tag":{"S":"v0.4.7"}}}' ;;
      totp_reencrypt_below_floor) echo '{"Item":{"minimum_release":{"N":"1000"},"minimum_tag":{"S":"v0.1.0"}}}' ;;
      fence_malformed) echo '{"Item":{"minimum_release":{"N":"abc"},"minimum_tag":{"S":"v0.1.0"}}}' ;;
      rollback_below_fence) echo '{"Item":{"minimum_release":{"N":"5000"},"minimum_tag":{"S":"v0.5.0"}}}' ;;
      rollback_equal_fence) echo '{"Item":{"minimum_release":{"N":"9"},"minimum_tag":{"S":"v0.0.9"}}}' ;;
      restore_below_fence) echo '{"Item":{"minimum_release":{"N":"1000"},"minimum_tag":{"S":"v0.1.0"}}}' ;;
      fence_uncertain_owned | fence_lock_retry_success)
        if ((n == 1)); then echo '{}'
        else printf '{"Item":{"operation_id":{"S":"%s"}}}' "$(cat "$STUB_DIR/lock-oid")"; fi ;;
      fence_uncertain_foreign)
        if ((n == 1)); then echo '{}'
        else echo '{"Item":{"operation_id":{"S":"some-other-operation"}}}'; fi ;;
      *) echo '{}' ;;
    esac ;;
  "aws "*"dynamodb update-item"*"operation_id=:o, operation_kind=:k"*)
    # Lock acquisition. The generated operation ID is captured so a later
    # uncertain-read case can prove or disprove this process owns it.
    oid=$(sed -E 's/.*":o":\{"S":"([^"]+)".*/\1/' <<<"$args")
    printf '%s' "$oid" >"$STUB_DIR/lock-oid"
    case $STUB_CASE in
      fence_locked | fence_lower | fence_lock_retry_success)
        echo "ConditionalCheckFailedException" >&2; exit 254 ;;
      fence_uncertain_owned | fence_uncertain_foreign) echo "connection reset" >&2; exit 255 ;;
      *) exit 0 ;;
    esac ;;
  "aws "*"dynamodb update-item"*"minimum_release=:c"*)
    if [[ $STUB_CASE == fence_raise_race ]]; then echo "ConditionalCheckFailedException" >&2; exit 254; fi
    exit 0 ;;
  "aws "*"dynamodb update-item"*"operation_checked_at=:s"*)
    case $STUB_CASE in
      fence_checkpoint_fails) echo "ConditionalCheckFailedException" >&2; exit 254 ;;
      checkpoint_fails_after_maintenance_down)
        if [[ -e $STUB_DIR/maintenance-scaled-down.$STUB_CASE ]]; then echo "ConditionalCheckFailedException" >&2; exit 254; fi ;;
      checkpoint_fails_after_migration)
        if [[ -e $STUB_DIR/migrated.$STUB_CASE ]]; then echo "ConditionalCheckFailedException" >&2; exit 254; fi ;;
    esac
    exit 0 ;;
  "curl "*"ghcr.io/token"*) echo '{"token":"stub"}' ;;
  "curl "*"/manifests/"*) printf 'docker-content-digest: sha256:%064d\r\n' 1 ;;
  "curl "*"api.cloudflare.com/client/v4/ips"*) echo '{"success":true,"result":{"ipv4_cidrs":["198.51.100.0/24","192.0.2.0/24"]}}' ;;
  "curl -fsSI https://aboutme.vn/")
    # smoke_flaky: the first HSTS probe hits a TLS reset, as right after a
    # Caddy restart.
    if [[ $STUB_CASE == smoke_flaky ]] && ! [[ -e $STUB_DIR/hsts.once ]]; then
      : >"$STUB_DIR/hsts.once"
      exit 35
    fi
    printf 'HTTP/2 200\r\nstrict-transport-security: max-age=31536000\r\n' ;;
  "curl "*"https://aboutme.vn/healthz"*)
    if [[ $STUB_CASE == smoke_down || $STUB_CASE == signal_during_cleanup ]]; then echo 502; exit 0; fi
    # smoke_flaky: Cloudflare serves one 525 first.
    if [[ $STUB_CASE == smoke_flaky ]] && ! [[ -e $STUB_DIR/healthz.once ]]; then
      : >"$STUB_DIR/healthz.once"
      echo 525
      exit 0
    fi
    echo 200 ;;
  "curl -s -m 10 -w "*)
    if [[ $STUB_CASE == maintenance_smoke_fails || $STUB_CASE == maintenance_down_fails || $STUB_CASE == alerts_recovery_fails ]]; then
      printf 'unavailable\n502\n'
    else
      printf '<!-- aboutme:maintenance -->\n503\n'
    fi ;;
  "curl -s -o /dev/null -m "*"-w %{http_code} %{time_total} https://aboutme.vn"*)
    # warm_path's own probe. $safe_path keys a per-path, per-case attempt
    # counter, since the same case warms both /danny and / independently.
    url=${args##* }
    path=${url#https://aboutme.vn}
    safe_path=${path//\//_}
    n=$(($(cat "$STUB_DIR/warm-count.$STUB_CASE$safe_path" 2>/dev/null || echo 0) + 1))
    echo "$n" >"$STUB_DIR/warm-count.$STUB_CASE$safe_path"
    case $STUB_CASE in
      warm_slow_then_fast)
        if ((n == 1)); then printf '502 0.2'
        elif ((n == 2)); then printf '200 5.0'
        else printf '200 0.4'; fi ;;
      warm_never_fast | cleanup_wait_signal | cleanup_rule_killed) printf '200 5.0' ;;
      warm_timeout)
        if ((n == 1)); then exit 28; else printf '200 0.4'; fi ;;
      *) printf '200 0.4' ;;
    esac ;;
  "curl "*"https://aboutme.vn/"*) echo 200 ;;
  "curl "*"https://192.0.2.10/"*)
    # origin_open: the origin answers a direct request.
    if [[ $STUB_CASE == origin_open ]]; then exit 0; fi
    exit 28 ;;
  "curl "*) exit 28 ;;
  "aws "*"ecs describe-task-definition"*"--task-definition arn:"*)
    # The service's actual running revision (fence_read, task_def_release_number),
    # distinct from a family's latest registration below.
    case $STUB_CASE in
      fence_missing_enrolled)
        echo '{"family":"f","containerDefinitions":[{"name":"server","environment":[{"name":"PASSKEY_ENROLLMENT_ENABLED","value":"true"}]}]}' ;;
      fence_missing_totp_enrolled)
        echo '{"family":"f","containerDefinitions":[{"name":"server","environment":[{"name":"TOTP_ENROLLMENT_ENABLED","value":"true"}]}]}' ;;
      fence_running_revision_differs)
        echo '{"family":"f","containerDefinitions":[{"name":"server","environment":[{"name":"PASSKEY_ENROLLMENT_ENABLED","value":"false"},{"name":"DEPLOY_RELEASE_NUMBER","value":"1000"}]}]}' ;;
      fence_activate | fence_raise_race | fence_lock_retry_success)
        echo '{"family":"f","containerDefinitions":[{"name":"server","environment":[{"name":"DEPLOY_RELEASE_NUMBER","value":"1000"}]}]}' ;;
      fence_activate_4002_then_4007)
        # The running app is already the v0.4.7 candidate, flag off; only the
        # stored fence minimum (still 4002 from the v0.4.2 activation) has not
        # caught up yet.
        echo '{"family":"f","containerDefinitions":[{"name":"server","environment":[{"name":"DEPLOY_RELEASE_NUMBER","value":"4007"}]}]}' ;;
      totp_reencrypt_ok | totp_reencrypt_runtask_fails | totp_reencrypt_task_fails | \
      totp_reencrypt_register_fails | totp_reencrypt_wait_timeout)
        # The running app's TOTP_ACTIVE_KEY/TOTP_PREVIOUS_KEY slots the new
        # totp-reencrypt revision (below) must match before it is registered.
        echo '{"family":"f","containerDefinitions":[{"name":"server","environment":[{"name":"DEPLOY_RELEASE_NUMBER","value":"4007"}],"secrets":[{"name":"TOTP_ACTIVE_KEY","valueFrom":"arn:aws:ssm:ap-southeast-1:1:parameter/aboutme/prod/totp/key-a"},{"name":"TOTP_PREVIOUS_KEY","valueFrom":"arn:aws:ssm:ap-southeast-1:1:parameter/aboutme/prod/totp/key-b"}]}]}' ;;
      totp_reencrypt_slot_mismatch)
        echo '{"family":"f","containerDefinitions":[{"name":"server","environment":[{"name":"DEPLOY_RELEASE_NUMBER","value":"4007"}],"secrets":[{"name":"TOTP_ACTIVE_KEY","valueFrom":"arn:aws:ssm:ap-southeast-1:1:parameter/aboutme/prod/totp/key-a"},{"name":"TOTP_PREVIOUS_KEY","valueFrom":"arn:aws:ssm:ap-southeast-1:1:parameter/aboutme/prod/totp/key-b"}]}]}' ;;
      totp_reencrypt_tag_mismatch)
        echo '{"family":"f","containerDefinitions":[{"name":"server","environment":[{"name":"DEPLOY_RELEASE_NUMBER","value":"4006"}]}]}' ;;
      restore_below_fence)
        echo '{"family":"f","containerDefinitions":[{"name":"server","environment":[{"name":"DEPLOY_RELEASE_NUMBER","value":"500"}]}]}' ;;
      fence_first_already_running)
        # Proves a real prior deploy, not OpenTofu's untouched placeholder.
        echo '{"family":"f","containerDefinitions":[{"name":"server","environment":[{"name":"DEPLOY_RELEASE_TAG","value":"v0.0.9"}]}]}' ;;
      fence_running_def_malformed)
        # Not JSON: the enrollment jq extractions must fail closed, not read
        # an empty value from this as if it proved enrollment off.
        echo 'not json' ;;
      *)
        echo '{"family":"f","containerDefinitions":[{"name":"server","environment":[]}]}' ;;
    esac ;;
  "aws "*"ecs describe-task-definition"*)
    if [[ $STUB_CASE == fence_missing_enrolled || $STUB_CASE == fence_running_revision_differs ]]; then
      echo '{"family":"f","networkMode":"bridge","containerDefinitions":[{"name":"caddy","image":"x","environment":[{"name":"CLOUDFLARE_RANGES","value":"192.0.2.0/24 198.51.100.0/24"}]},{"name":"server","image":"x","environment":[{"name":"PASSKEY_ENROLLMENT_ENABLED","value":"true"}],"secrets":[{"name":"PGPASSWORD","valueFrom":"arn:aws:ssm:ap-southeast-1:1:parameter/aboutme/prod/db/app-password"},{"name":"GOOGLE_CLIENT_ID","valueFrom":"/aboutme/prod/oauth/google-client-id"},{"name":"MASTER","valueFrom":"arn:aws:secretsmanager:ap-southeast-1:1:secret:rds!db-abc-XyZ12:password::"}]}]}'
      exit 0
    fi
    if [[ $STUB_CASE == fence_new_revision_totp_enrolled ]]; then
      echo '{"family":"f","networkMode":"bridge","containerDefinitions":[{"name":"caddy","image":"x","environment":[{"name":"CLOUDFLARE_RANGES","value":"192.0.2.0/24 198.51.100.0/24"}]},{"name":"server","image":"x","environment":[{"name":"TOTP_ENROLLMENT_ENABLED","value":"true"}],"secrets":[{"name":"PGPASSWORD","valueFrom":"arn:aws:ssm:ap-southeast-1:1:parameter/aboutme/prod/db/app-password"},{"name":"GOOGLE_CLIENT_ID","valueFrom":"/aboutme/prod/oauth/google-client-id"},{"name":"MASTER","valueFrom":"arn:aws:secretsmanager:ap-southeast-1:1:secret:rds!db-abc-XyZ12:password::"}]}]}'
      exit 0
    fi
    case $STUB_CASE in
      totp_reencrypt_ok | totp_reencrypt_runtask_fails | totp_reencrypt_task_fails | \
      totp_reencrypt_register_fails | totp_reencrypt_wait_timeout)
        # current_def totp-reencrypt: key slots match the running app's, above.
        echo '{"family":"aboutme-prod-totp-reencrypt","networkMode":"bridge","requiresCompatibilities":["EC2"],"containerDefinitions":[{"name":"totp-reencrypt","image":"x","environment":[],"secrets":[{"name":"TOTP_ACTIVE_KEY","valueFrom":"arn:aws:ssm:ap-southeast-1:1:parameter/aboutme/prod/totp/key-a"},{"name":"TOTP_PREVIOUS_KEY","valueFrom":"arn:aws:ssm:ap-southeast-1:1:parameter/aboutme/prod/totp/key-b"}]}]}'
        exit 0 ;;
      totp_reencrypt_slot_mismatch)
        # Only the active slot, and it differs from the running app's above:
        # an un-applied OpenTofu change to the key slots.
        echo '{"family":"aboutme-prod-totp-reencrypt","networkMode":"bridge","requiresCompatibilities":["EC2"],"containerDefinitions":[{"name":"totp-reencrypt","image":"x","environment":[],"secrets":[{"name":"TOTP_ACTIVE_KEY","valueFrom":"arn:aws:ssm:ap-southeast-1:1:parameter/aboutme/prod/totp/key-c"}]}]}'
        exit 0 ;;
    esac
    if [[ $STUB_CASE == totp_key_secret_missing ]]; then
      # No TOTP_ACTIVE_KEY: OpenTofu has not been applied for the TOTP key yet.
      echo '{"family":"f","networkMode":"bridge","containerDefinitions":[{"name":"caddy","image":"x","environment":[{"name":"CLOUDFLARE_RANGES","value":"192.0.2.0/24 198.51.100.0/24"}]},{"name":"server","image":"x","secrets":[{"name":"PGPASSWORD","valueFrom":"arn:aws:ssm:ap-southeast-1:1:parameter/aboutme/prod/db/app-password"}]}]}'
      exit 0
    fi
    # One secret in each valueFrom form: SSM ARN, SSM name, Secrets Manager ARN.
    echo '{"family":"f","networkMode":"bridge","containerDefinitions":[{"name":"caddy","image":"x","environment":[{"name":"CLOUDFLARE_RANGES","value":"192.0.2.0/24 198.51.100.0/24"}]},{"name":"server","image":"x","secrets":[{"name":"PGPASSWORD","valueFrom":"arn:aws:ssm:ap-southeast-1:1:parameter/aboutme/prod/db/app-password"},{"name":"GOOGLE_CLIENT_ID","valueFrom":"/aboutme/prod/oauth/google-client-id"},{"name":"MASTER","valueFrom":"arn:aws:secretsmanager:ap-southeast-1:1:secret:rds!db-abc-XyZ12:password::"},{"name":"TOTP_ACTIVE_KEY","valueFrom":"arn:aws:ssm:ap-southeast-1:1:parameter/aboutme/prod/totp/key-a"}]}]}' ;;
  "aws "*"ssm describe-parameters"*)
    if [[ $STUB_CASE == secret_missing && $args == *google-client-id* ]]; then echo 0; else echo 1; fi ;;
  "aws "*"secretsmanager describe-secret"*)
    if [[ $STUB_CASE == secretsmanager_missing ]]; then
      echo "ResourceNotFoundException" >&2
      exit 254
    fi
    echo 'arn:aws:secretsmanager:ap-southeast-1:1:secret:rds!db-abc-XyZ12' ;;
  "aws "*"ecs describe-services"*"--output json"*)
    # fence_read's fresh-vs-deployed proof and --activate's stability and
    # release-match check both read this shape: stable is
    # runningCount == desiredCount > 0.
    if [[ $STUB_CASE == fence_missing_describe_error ]]; then exit 255; fi
    case $STUB_CASE in
      fence_first_already_running)
        # A real prior deploy scaled the service to zero; OpenTofu's own
        # placeholder is never registered again once deploy.sh has run.
        echo '{"services":[{"taskDefinition":"arn:aws:ecs:ap-southeast-1:1:task-definition/aboutme-prod-app:3","runningCount":0,"desiredCount":0}]}' ;;
      *first*)
        # OpenTofu's own placeholder task definition at desired count 0: a
        # real, non-null ARN that deploy.sh has never registered.
        echo '{"services":[{"taskDefinition":"arn:aws:ecs:ap-southeast-1:1:task-definition/aboutme-prod-app-placeholder:1","runningCount":0,"desiredCount":0}]}' ;;
      *)
        echo '{"services":[{"taskDefinition":"arn:aws:ecs:ap-southeast-1:1:task-definition/aboutme-prod-app:3","runningCount":1,"desiredCount":1}]}' ;;
    esac ;;
  "aws "*"ecs describe-services"*"services[0].status"*)
    if [[ $STUB_CASE == maintenance_missing ]]; then echo None; else echo ACTIVE; fi ;;
  "aws "*"ecs describe-services"*)
    if [[ $STUB_CASE == fence_missing_describe_error ]]; then exit 255; fi
    if [[ $STUB_CASE == fence_first_already_running ]]; then
      echo 'arn:aws:ecs:ap-southeast-1:1:task-definition/aboutme-prod-app:3'
    elif [[ $STUB_CASE == *first* ]]; then echo None
    else echo 'arn:aws:ecs:ap-southeast-1:1:task-definition/aboutme-prod-app:3'; fi ;;
  "aws "*"ecs list-tasks"*)
    if [[ $STUB_CASE == list_running_fails && $args == *"--service-name aboutme-prod-app"* && $args != *"--desired-status STOPPED"* ]]; then
      exit 255
    fi
    if [[ $STUB_CASE == list_stopped_fails && $args == *"--service-name aboutme-prod-app"* && $args == *"--desired-status STOPPED"* ]]; then
      exit 255
    fi
    if [[ $STUB_CASE == stopping_task ]]; then
      if [[ $args == *"--desired-status STOPPED"* ]]; then
        echo "arn:aws:ecs:ap-southeast-1:1:task/aboutme-prod/stopping-task"
      else
        echo "arn:aws:ecs:ap-southeast-1:1:task/aboutme-prod/running-task"
      fi
    else
      echo "arn:aws:ecs:ap-southeast-1:1:task/aboutme-prod/stub-task"
    fi ;;
  "aws "*"ecs register-task-definition"*)
    file=$(sed -E 's#.*file://([^ ]+).*#\1#' <<<"$args")
    cp "$file" "$STUB_DIR/last-registered.json"
    if [[ $STUB_CASE == totp_reencrypt_register_fails ]]; then
      echo "conflict" >&2
      exit 255
    fi
    jq -e '.containerDefinitions and (has("revision") | not)
      and (.containerDefinitions | all((.environment // []) | any(.name == "DEPLOY_RELEASE_TAG")))' \
      "$file" >/dev/null || exit 3
    echo 'arn:aws:ecs:ap-southeast-1:1:task-definition/new:4' ;;
  "aws "*"ecs run-task"*)
    by=$(sed -E 's/.*--started-by ([^ ]+).*/\1/' <<<"$args")
    [[ $by != deploy-migrate ]] || : >"$STUB_DIR/migrated.$STUB_CASE"
    if [[ $STUB_CASE == runtask_fails && $by == deploy-migrate ]]; then
      echo "placement failed" >&2
      exit 255
    fi
    if [[ $STUB_CASE == totp_reencrypt_runtask_fails && $by == deploy-totp-reencrypt ]]; then
      echo "placement failed" >&2
      exit 255
    fi
    echo "arn:aws:ecs:ap-southeast-1:1:task/aboutme-prod/$by" ;;
  "aws "*"ecs update-service"*"aboutme-prod-maintenance"*"desired-count 0"*)
    : >"$STUB_DIR/maintenance-scaled-down.$STUB_CASE" ;;
  "aws "*"ecs update-service"*"aboutme-prod-app"*"desired-count 1"*)
    [[ $STUB_CASE != app_start_update_fails ]] || exit 255 ;;
  "aws "*"ecs wait services-stable"*"aboutme-prod-web"*)
    if [[ $STUB_CASE == start_fails || $STUB_CASE == restore_below_fence ]]; then exit 255; fi ;;
  "aws "*"ecs wait services-stable"*"aboutme-prod-maintenance"*)
    if [[ $STUB_CASE == maint_up_fails ]]; then exit 255; fi
    if [[ $STUB_CASE == maintenance_down_fails || $STUB_CASE == alerts_recovery_fails ]]; then
      n=$(($(cat "$STUB_DIR/$STUB_CASE.maint-wait-count" 2>/dev/null || echo 0) + 1))
      echo "$n" >"$STUB_DIR/$STUB_CASE.maint-wait-count"
      ((n != 2)) || exit 255
    fi ;;
  "aws "*"ecs wait services-stable"*"aboutme-prod-app"*)
    if [[ $STUB_CASE == first_app_down_fails ]] && ! [[ -e $STUB_DIR/first-app-wait.once ]]; then
      : >"$STUB_DIR/first-app-wait.once"
      exit 255
    fi
    # app_wait_fails: the first app wait (scaling to 0 at "site down") must
    # succeed; only the second (starting the new app, post-migration) fails.
    if [[ $STUB_CASE == app_wait_fails ]]; then
      if [[ -e $STUB_DIR/app-wait.once ]]; then exit 255; fi
      : >"$STUB_DIR/app-wait.once"
    fi ;;
  "aws "*"ecs wait tasks-stopped"*)
    if [[ $STUB_CASE == wait_timeout && $args == *deploy-migrate* ]]; then exit 255; fi
    if [[ $STUB_CASE == totp_reencrypt_wait_timeout && $args == *deploy-totp-reencrypt* ]]; then exit 255; fi ;;
  "aws "*"ecs describe-tasks"*"lastStatus"*)
    if [[ $STUB_CASE == wait_timeout || $STUB_CASE == totp_reencrypt_wait_timeout ]]; then echo RUNNING; else echo STOPPED; fi ;;
  "aws "*"ecs describe-tasks"*)
    if [[ $STUB_CASE == *migrate_fails && $args == *deploy-migrate* ]]; then echo 1;
    elif [[ $STUB_CASE == *db_setup_fails && $args == *deploy-db-setup* ]]; then echo 1;
    elif [[ $STUB_CASE == totp_reencrypt_task_fails && $args == *deploy-totp-reencrypt* ]]; then echo 1;
    else echo 0; fi ;;
  "aws "*"cloudwatch describe-alarms"*"--output json"*)
    # wait_for_site_alarm_healthy's own read: StateValue plus the alarm's
    # static evaluation shape (EvaluationPeriods=3, Period=60, Threshold=1,
    # ComparisonOperator=LessThanThreshold, Statistic=Minimum), matching
    # deploy/aws/modules/ops/main.tf's aws_cloudwatch_metric_alarm.site.
    n=$(($(cat "$STUB_DIR/alarm-describe-count.$STUB_CASE" 2>/dev/null || echo 0) + 1))
    echo "$n" >"$STUB_DIR/alarm-describe-count.$STUB_CASE"
    if [[ $STUB_CASE == alarm_signal_during_wait ]] && ((n == 1)); then
      kill -TERM "$PPID"
    elif [[ $STUB_CASE == cleanup_wait_signal ]] && ((n == 1)); then
      # This read runs inside deploy.sh's on_exit (a running trap), where a
      # command substitution forks a real subshell rather than exec'ing
      # directly into this stub: $PPID here is that subshell, not deploy.sh
      # itself, so run_case's own recorded PID is the one to signal.
      kill -TERM "$(cat "$STUB_DIR/$STUB_CASE.pid")"
    fi
    astate=OK
    comparison=LessThanThreshold
    case $STUB_CASE in
      alarm_late_alarm) ((n <= 2)) && astate=ALARM ;;
      # An alarm someone edited outside OpenTofu: the wait must never treat
      # this shape as healthy.
      alarm_shape_changed) comparison=LessThanOrEqualToThreshold ;;
    esac
    printf '{"MetricAlarms":[{"StateValue":"%s","ComparisonOperator":"%s","Statistic":"Minimum","EvaluationPeriods":3,"Period":60,"Threshold":1,"Dimensions":[{"Name":"HealthCheckId","Value":"hc-stub-1"}]}]}' \
      "$astate" "$comparison" ;;
  "aws "*"cloudwatch get-metric-statistics"*)
    if [[ $STUB_CASE == alarm_metric_error ]]; then
      echo "AccessDeniedException: user is not authorized to perform this action" >&2
      exit 254
    fi
    # Route 53's post-recovery healthy-minute count, read under the base
    # caller's own profile (see wait_for_site_alarm_healthy). The wait now
    # requires EvaluationPeriods (3) + 1 healthy minutes at the newest end.
    n=$(($(cat "$STUB_DIR/alarm-metric-count.$STUB_CASE" 2>/dev/null || echo 0) + 1))
    echo "$n" >"$STUB_DIR/alarm-metric-count.$STUB_CASE"
    # Minimums oldest first internally, with the oldest value unhealthy: an
    # implementation that skips sorting drops the wrong end and fails.
    # CloudWatch does not promise an order, so the ok case emits them oldest
    # first and the rest emit newest first, exercising the script's own sort
    # both ways.
    values=(0 1 1 1 1)
    case $STUB_CASE in
      alarm_ok_stale) values=(0); for ((i = 0; i < n && i < 4; i++)); do values+=(1); done ;;
      alarm_never_ok | cleanup_wait_signal | alarm_timeout_enable_retry) values=(0 1) ;;
      # Three healthy minutes then an unhealthy newest one on the first read.
      alarm_flap) if ((n == 1)); then values=(1 1 1 0); else values=(1 1 1 0 1 1 1 1); fi ;;
    esac
    dp=""
    if [[ $STUB_CASE == ok ]]; then
      for ((i = 0; i < ${#values[@]}; i++)); do
        dp+=$(printf '{"Timestamp":"2026-10-20T00:%02d:00Z","Minimum":%s},' "$((i + 1))" "${values[i]}")
      done
    else
      for ((i = ${#values[@]} - 1; i >= 0; i--)); do
        dp+=$(printf '{"Timestamp":"2026-10-20T00:%02d:00Z","Minimum":%s},' "$((i + 1))" "${values[i]}")
      done
    fi
    printf '{"Datapoints":[%s]}' "${dp%,}" ;;
  "aws "*"cloudwatch describe-alarms"*)
    if [[ $STUB_CASE == alerts_initially_disabled ]]; then echo False
    elif [[ $STUB_CASE == alerts_site_mismatch && -e $STUB_DIR/site-disabled ]]; then echo True
    elif [[ -e $STUB_DIR/site-disabled ]]; then echo False
    else echo True; fi ;;
  "aws "*"cloudwatch disable-alarm-actions"*)
    : >"$STUB_DIR/site-disabled"
    if [[ $STUB_CASE == alerts_site_lost ]]; then exit 255; fi ;;
  "aws "*"cloudwatch enable-alarm-actions"*)
    rm -f "$STUB_DIR/site-disabled"
    if [[ $STUB_CASE == signal_during_cleanup ]]; then kill -TERM "$PPID"; fi
    if [[ $STUB_CASE == alarm_timeout_enable_retry ]]; then
      n=$(($(cat "$STUB_DIR/enable-count.$STUB_CASE" 2>/dev/null || echo 0) + 1))
      echo "$n" >"$STUB_DIR/enable-count.$STUB_CASE"
      ((n != 1)) || exit 255
    fi
    [[ $STUB_CASE != alerts_restore_fails ]] || exit 255 ;;
  "aws "*"events describe-rule"*)
    if [[ $STUB_CASE == alerts_initially_disabled ]]; then echo DISABLED
    elif [[ -e $STUB_DIR/task-rule-disabled ]]; then echo DISABLED
    else echo ENABLED; fi ;;
  "aws "*"events disable-rule"*)
    : >"$STUB_DIR/task-rule-disabled"
    if [[ $STUB_CASE == alerts_rule_lost ]]; then exit 255; fi
    if [[ $STUB_CASE == alerts_signal ]]; then kill -TERM "$PPID"; fi ;;
  "aws "*"events enable-rule"*)
    # cleanup_rule_killed: a Ctrl-C meant for the cleanup wait reaches this
    # call first; deploy.sh gets the signal and this call dies unfinished.
    if [[ $STUB_CASE == cleanup_rule_killed && ! -e $STUB_DIR/$STUB_CASE.rule-killed ]]; then
      : >"$STUB_DIR/$STUB_CASE.rule-killed"
      kill -TERM "$(cat "$STUB_DIR/$STUB_CASE.pid")"
      exit 130
    fi
    rm -f "$STUB_DIR/task-rule-disabled" ;;
  "aws "*"scheduler list-schedules"*) printf 'a\tb\tc\td\n' ;;
  "aws "*"scheduler get-schedule"*)
    state=ENABLED
    [[ $STUB_CASE == first* ]] && state=DISABLED
    if [[ $args == *"--query State"* ]]; then
      echo "$state"
      exit 0
    fi
    printf '{"Name":"a","GroupName":"g","ScheduleExpression":"rate(1 hour)","FlexibleTimeWindow":{"Mode":"OFF"},"Target":{"Arn":"x","RoleArn":"y"},"State":"%s","Arn":"z"}\n' "$state" ;;
  "aws "*"scheduler update-schedule"*)
    file=$(sed -E 's#.*file://([^ ]+).*#\1#' <<<"$args")
    cp "$file" "$STUB_DIR/last-schedule.json"
    # schedule_enable_fails: the enable loop's second schedule (of a, b, c, d)
    # fails after the app is already confirmed healthy; the first stays
    # enabled, the rest are never attempted.
    if [[ $STUB_CASE == schedule_enable_fails ]] && grep -q '"State": "ENABLED"' "$file"; then
      n=$(($(cat "$STUB_DIR/enable-count" 2>/dev/null || echo 0) + 1))
      echo "$n" >"$STUB_DIR/enable-count"
      if ((n == 2)); then
        echo "scheduler throttled" >&2
        exit 254
      fi
    fi ;;
  "aws "*"ec2 describe-addresses"*)
    if [[ $STUB_CASE == origin_unknown ]]; then echo None; exit 0; fi
    echo 192.0.2.10 ;;
  # The snapshot name's time is fixed at 2026-10-20T00:00Z.
  "date -u +%Y%m%d%H%M") echo 202610200000 ;;
  *) exit 0 ;;
esac
