	respond 404
}

@aboutme_fixed_go path /.well-known /.well-known/* /api /api/* /healthz /healthz/* /healthz.md /llms.txt /llms.txt/* /mcp /mcp/* /oauth /oauth/* /oauth.md /readyz /readyz/* /readyz.md /robots.txt /robots.txt/* /sitemap.xml /sitemap.xml/*
