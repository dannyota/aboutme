# Current Compose route table. docs/design/system.md owns intended route
# ownership; docs/api/openapi.yaml owns implemented HTTP contracts. This
# listener is HTTP-only and does not satisfy the P9 HTTPS/443 UAT gate.
#
# /api/v1/* and generated discovery paths go to Go. /print is internal and
# denied at the viewer edge. All other paths go to Nuxt.
{
	admin off
}

:80 {
	encode zstd gzip

	@print path /print /print/*
	# Caddy is the client-IP trust boundary. Remove viewer forwarding headers
	# before setting the sole header Go accepts. See docs/design/deployment.md.
	# This direct-peer rule is for the current local deployment only.
	request_header -X-Real-IP
	request_header -X-Forwarded-For
	request_header -Forwarded

	handle @print {
		respond 404
	}

	@go path /api/v1/* /healthz /readyz /sitemap.xml /robots.txt /llms.txt /*.md
	handle @go {
		reverse_proxy server:8080 {
			# The current local viewer connects directly to Caddy.
			header_up X-Real-IP {http.request.remote.host}
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
