# Current Compose route table. docs/design/system.md owns intended route
# ownership; docs/api/openapi.yaml owns implemented HTTP contracts. This
# listener is HTTP-only and does not satisfy the local-UAT HTTPS/443 contract
# (docs/runbooks/local-uat.md).
#
# Generated fixed routes and valid public slugs go to their registry owner.
# Denied and reserved roots never reach an upstream. Other paths go to Nuxt.
{
	admin off
	# Request logs keep the method, URI, and status but never the visitor's
	# address or request headers, matching production.
	log default {
		output stderr
		format filter {
			wrap json
			request>client_ip delete
			request>remote_ip delete
			request>remote_port delete
			request>headers delete
		}
	}
}

:80 {
	encode zstd gzip

	# Caddy is the client-IP trust boundary. Remove viewer forwarding headers
	# before setting the sole header Go accepts. See docs/design/deployment.md.
	# This direct-peer rule is for the current local deployment only.
	request_header -X-Real-IP
	request_header -X-Forwarded-For
	request_header -Forwarded

	# ABOUTME_PUBLIC_ROOTS_GENERATED
	import /etc/caddy/generated/public-roots.generated.caddy

	handle {
		reverse_proxy web:3000
	}
}
