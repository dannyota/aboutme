{
	admin off
	# No site below turns on Caddy's access log, so an ordinary request is
	# never logged, matching production. This shapes the format
	# for whatever Caddy still writes on its own, such as a failed
	# reverse_proxy dial: it keeps the method and URI but never the
	# visitor's address or request headers.
	log default {
		output stderr
		format filter {
			wrap json
			request>client_ip delete
			request>remote_ip delete
			request>remote_port delete
			request>headers delete
		}
	}
}

:80 {
	encode zstd gzip

	request_header -X-Real-IP
	request_header -X-Forwarded-For
	request_header -Forwarded

	request_header -x-amzn-waf-aboutme-bot
	request_header -x-amzn-waf-aboutme-dc

	# ABOUTME_PUBLIC_ROOTS_GENERATED
	import /etc/caddy/generated/public-roots.generated.caddy

	handle {
		reverse_proxy web:3000
	}
}
