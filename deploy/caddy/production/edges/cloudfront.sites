(cloudfront_tls) {
	tls /run/caddy/origin.pem /run/caddy/origin-key.pem {
		client_auth {
			mode require_and_verify
			trust_pool file /run/caddy/cloudfront-ca.pem
		}
	}
}

(cloudfront_response_headers) {
	header {
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options nosniff
		-Server
		-Via
		defer
	}
}

www.aboutme.vn:8443 {
	import cloudfront_tls
	import cloudfront_response_headers
	redir https://aboutme.vn{uri} permanent
}

aboutme.vn:8443 {
	import cloudfront_tls
	import cloudfront_response_headers

	request_header -X-Real-IP
	request_header -X-Forwarded-For
	request_header -Forwarded
	request_header -X-Forwarded-Host
	request_header -CF-Connecting-IP

	@viewer_address vars_regexp viewer {http.request.header.CloudFront-Viewer-Address} ^([0-9A-Fa-f:.]+):([0-9]{1,5})$
	vars @viewer_address client_address {re.viewer.1}
	request_header -CloudFront-Viewer-Address

	vars waf_bot {http.request.header.x-amzn-waf-aboutme-bot}
	vars waf_dc {http.request.header.x-amzn-waf-aboutme-dc}
	@waf_headers expression true
	@had_waf_bot expression {vars.waf_bot} != ""
	@had_waf_dc expression {vars.waf_dc} != ""
	request_header @waf_headers -x-amzn-waf-*
	request_header @had_waf_bot x-amzn-waf-aboutme-bot 1
	request_header @had_waf_dc x-amzn-waf-aboutme-dc 1

	import apex_site
}
