# Server options for the Cloudflare listener on 443. entrypoint.sh copies this
# file into the global options block when EDGES includes cloudflare.
# {client_ip} is CF-Connecting-IP only when the peer is in CLOUDFLARE_RANGES;
# otherwise it is the peer address.
servers :443 {
	trusted_proxies static {$CLOUDFLARE_RANGES}
	trusted_proxies_strict
	client_ip_headers CF-Connecting-IP
	# Cloudflare reaches the origin over TCP, so no HTTP/3 listener.
	protocols h1 h2
}
