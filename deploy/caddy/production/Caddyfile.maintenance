# Maintenance-mode production route table. entrypoint.sh selects this file
# instead of Caddyfile when MAINTENANCE=1. Every path and method on the apex
# gets maintenance.html at 503, served verbatim by file_server so nothing in
# the page can be read as a Caddy placeholder; see maintenance-render.sh for
# the generated headers this imports, built the same way as routes.caddy.
#
# It imports the same edge listeners as Caddyfile (see edges/), so both carry
# the same client certificate trust and client address rule; only the
# apex_site snippet differs. www still redirects to the apex, as in
# Caddyfile: the page polls /readyz on its own origin, and a visitor's tab
# must keep pointing at the apex across the deploy, or the poll becomes a
# blocked cross-origin fetch once maintenance mode ends and www starts
# redirecting again.
{
	admin off
	# No automatic HTTP-to-HTTPS redirect server. CloudFront reaches the
	# origin over HTTPS on 8443 only, so with only that edge Caddy binds no
	# privileged port and runs with no capability. The direct edge declares
	# its own port 80 site (edges/direct.sites).
	auto_https disable_redirects
	import /run/caddy/edges.global
	# No site below turns on Caddy's access log, so an ordinary request is
	# never logged. This shapes the format for whatever Caddy still writes
	# on its own, such as a failed reverse_proxy dial: it keeps the method
	# and URI but never the visitor's address or request headers (privacy
	# policy: no IP in logs).
	log default {
		output stderr
		# Coraza's rule matches name the client address; edges/direct.global
		# sends them to a local file instead.
		exclude http.handlers.waf
		format filter {
			wrap json
			request>client_ip delete
			request>remote_ip delete
			request>remote_port delete
			request>headers delete
		}
	}
}

(apex_site) {
	import /etc/caddy/maintenance.generated.caddy
	root * /etc/caddy/maintenance-site
	rewrite * /maintenance.html
	# file_server serves only GET and HEAD. Change every other request to GET so
	# it serves the same static 503 page. Keep HEAD untouched so its body stays
	# empty.
	@maintenance_body not method HEAD
	method @maintenance_body GET
	file_server {
		status 503
	}
}

import /run/caddy/edges.sites
