# Production route table for the single-host deployment. See
# docs/design/single-host-production.md, docs/design/cloudfront-edge.md, and
# docs/design/vietnam-production.md. Each edge listener (CloudFront on 8443,
# direct on 80 and 443) has its own TLS and client address rule in edges/;
# entrypoint.sh concatenates the edges named in EDGES into
# /run/caddy/edges.global and /run/caddy/edges.sites. Each listener sets
# {vars.client_address}, which routes.caddy sends to Go as X-Real-IP.
{
	admin off
	# No automatic HTTP-to-HTTPS redirect server. CloudFront reaches the
	# origin over HTTPS on 8443 only, so with only that edge Caddy binds no
	# privileged port and runs with no capability. The direct edge declares
	# its own port 80 site (edges/direct.sites).
	auto_https disable_redirects
	import /run/caddy/edges.global
	# CloudFront keeps no access log and retains the method and URI on runtime
	# errors, without addresses or headers. The direct edge routes request data
	# through fixed allowlist encoders instead.
	log default {
		output stderr
		# Direct-edge WAF, CrowdSec, and HTTP errors use private allowlist
		# loggers. CloudFront-only keeps its existing error output.
		import /run/caddy/default-log-excludes.caddy
		format filter {
			wrap json
			request>client_ip delete
			request>remote_ip delete
			request>remote_port delete
			request>headers delete
		}
	}
}

(apex_site) {
	encode zstd gzip

	import /etc/caddy/routes.caddy

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

import /run/caddy/edges.sites
