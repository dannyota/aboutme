# Production route table for the single-host deployment. See
# docs/design/single-host-production.md. {client_ip} is CF-Connecting-IP only
# when the peer is in CLOUDFLARE_RANGES; otherwise it is the peer address.
{
	admin off
	servers {
		trusted_proxies static {$CLOUDFLARE_RANGES}
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
		# Cloudflare reaches the origin over TCP, so no HTTP/3 listener.
		protocols h1 h2
	}
	# Request logs keep the method, URI, and status but never the visitor's
	# address or request headers (privacy policy: no IP in request logs).
	log default {
		output stderr
		format filter {
			wrap json
			request>client_ip delete
			request>remote_ip delete
			request>remote_port delete
			request>headers delete
		}
	}
}

(origin_tls) {
	tls /run/caddy/origin.pem /run/caddy/origin-key.pem {
		client_auth {
			mode require_and_verify
			trust_pool file /run/caddy/origin-pull-ca.pem
		}
	}
}

www.aboutme.vn {
	import origin_tls
	redir https://aboutme.vn{uri} permanent
}

aboutme.vn {
	import origin_tls
	encode zstd gzip

	request_header -X-Real-IP
	request_header -X-Forwarded-For
	request_header -Forwarded

	import /etc/caddy/routes.caddy

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
