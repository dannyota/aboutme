{
	admin off
	# Podman's default stop timeout is 10s (podman-stop(1)).
	grace_period 5s
	auto_https disable_redirects
	import /run/caddy/edges.global
	log default {
		output stderr
		import /run/caddy/default-log-excludes.caddy
		format filter {
			wrap json
			request>client_ip delete
			request>remote_ip delete
			request>remote_port delete
			request>headers delete
		}
	}
}

(apex_site) {
	encode zstd gzip

	import /etc/caddy/routes.caddy

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

import /run/caddy/edges.sites
