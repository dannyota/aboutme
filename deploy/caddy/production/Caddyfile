# Production route table for the single-host deployment. See
# docs/design/single-host-production.md and docs/design/cloudfront-edge.md.
# The CloudFront listener on 8443 has its own TLS client trust and client
# address rule in edges/; entrypoint.sh concatenates the edges named in EDGES
# into /run/caddy/edges.global and /run/caddy/edges.sites. The listener sets
# {vars.client_address}, which routes.caddy sends to Go as X-Real-IP.
{
	admin off
	# No HTTP-to-HTTPS redirect server on port 80. CloudFront reaches the
	# origin over HTTPS on 8443 only, and the security group admits nothing
	# else, so that server would answer no one. Without it Caddy binds no
	# privileged port and runs as a non-root user with no capability.
	auto_https disable_redirects
	import /run/caddy/edges.global
	# Request logs keep the method, URI, and status but never the visitor's
	# address or request headers (privacy policy: no IP in request logs).
	log default {
		output stderr
		format filter {
			wrap json
			request>client_ip delete
			request>remote_ip delete
			request>remote_port delete
			request>headers delete
		}
	}
}

(apex_site) {
	encode zstd gzip

	import /etc/caddy/routes.caddy

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

import /run/caddy/edges.sites
