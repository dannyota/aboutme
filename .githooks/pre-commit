#!/usr/bin/env bash
set -Eeuo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; cannot verify staged content." >&2
  echo "Install gitleaks, or bypass this ONE commit with --no-verify if you" >&2
  echo "have manually confirmed no secret is staged." >&2
  exit 1
fi

make --no-print-directory tools-check ARGS=gitleaks
gitleaks protect --staged --redact --no-banner
bash scripts/check-lengths.sh
