#!/usr/bin/env bash
# Block secrets from ever reaching a commit. This repository is public, so a
# secret that lands in history is exposed the moment it is pushed and cannot be
# recalled -- rotating the key is the only real remedy. gitleaks takes about a
# second on staged content, which is why this runs per commit while the heavier
# Semgrep scan is batched to phase gates (`make scan`).
#
# Install with: make hooks-install
set -Eeuo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; cannot verify staged content." >&2
  echo "Install gitleaks, or bypass this ONE commit with --no-verify if you" >&2
  echo "have manually confirmed no secret is staged." >&2
  exit 1
fi

gitleaks protect --staged --redact --no-banner
